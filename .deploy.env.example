# Direct deploy configuration — copy to .deploy.env, which is git-ignored.
#
#     cp .deploy.env.example .deploy.env
#
# Nothing here is a secret except the key, and the key is a PATH on this
# machine: its contents are never read by anything in this repository and never
# belong in a file inside it.
#
# These are the same values GitHub Actions would hold as repository secrets.
# Keeping them here lets scripts/deploy-direct.sh (staging only) and the read-only
# preflight/verify scripts reach the server. Production is never deployed from here.

# The server.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=leadflow-deploy
DEPLOY_PORT=22

# The private half of the deploy key, as a path. Generated with
#     ssh-keygen -t ed25519 -f ~/.ssh/leadflow_deploy -C 'leadflow deploy'
# and its public half installed with the forced-command options documented in
# docs/VPS_CADDY_PLAN.md. The account has no interactive shell or Docker access.
DEPLOY_SSH_KEY=~/.ssh/leadflow_deploy
DEPLOY_RESTRICTED_COMMAND=true

# Where each environment lives on that server. scripts/provision-server.sh
# creates both.
STAGING_PATH=/var/www/leads-crm/staging
PRODUCTION_PATH=/opt/leadflow-crm

# How each one is reached from the internet. A deploy that cannot be verified
# over HTTPS at these names is treated as a failed deploy.
STAGING_DOMAIN=staging.example.com
PRODUCTION_DOMAIN=app.example.com

# DEPLOY_SECRET is deliberately absent. It lives in the server's own .env file,
# where the on-server deploy script reads it to prove the new build went live.
# Sending it from here would put it in the process list of every user on the box.
