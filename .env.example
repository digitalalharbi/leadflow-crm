# ---------------------------------------------------------------------------
# Docker Compose environment. Copy to .env and fill in before `docker compose up`.
# Never commit the filled-in .env.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=leadflow

# Application
APP_NAME="مهتم"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=ar

# Root domain used for subdomain tenant resolution (client1.example.com)
APP_CENTRAL_DOMAIN=localhost

# SPA
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Database (service name `postgres` inside Docker)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=leadflow_local
DB_USERNAME=leadflow
DB_PASSWORD=change-me

# Redis (service name `redis` inside Docker)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

# Platform super admin. Seeding REFUSES to run outside local development unless
# SUPER_ADMIN_PASSWORD is set — this account can read and rebrand every tenant.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_PASSWORD=

# Ports exposed on the host
APP_PORT=8000
WEB_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# Comma-separated proxy addresses or CIDRs to trust for X-Forwarded-* headers.
# Leave EMPTY unless the app sits behind a load balancer you control: trusting
# every proxy lets a caller forge their IP, which bypasses the login rate limit
# and falsifies the audit log.
TRUSTED_PROXIES=

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"

# ---------------------------------------------------------------------------
# External integrations. Leave blank to run the provider in sandbox/mock mode.
# See EXTERNAL_SETUP.md for how to obtain each one.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
