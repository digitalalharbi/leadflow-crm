# ---------------------------------------------------------------------------
# Production environment. Copy to .env.production ON THE VPS and fill in.
# This file is a template only — .env.production is git-ignored and must stay so.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d
# ---------------------------------------------------------------------------

# Generate with: docker compose -f docker-compose.production.yml run --rm backend \
#   php artisan key:generate --show
APP_KEY=

# Production is HTTPS only. The staging template offers an http/IP mode for a
# server without a certificate yet; there is deliberately no equivalent here,
# because bearer tokens and session cookies would cross the network in clear
# text and this environment holds real customers' data.

# Domains. Both must resolve to this VPS and have certificates (see docker/nginx/edge.mohtam.conf.example).
# www.mohtam.pro redirects to the apex; tracking links are https://api.mohtam.pro/t/<token>.
# go.mohtam.pro is reserved in DNS for the Tracking Hub release and is not served yet.
PRODUCTION_DOMAIN=mohtam.pro
PRODUCTION_API_DOMAIN=api.mohtam.pro

# Database. A password only this environment uses.
DB_DATABASE=leadflow_production
DB_USERNAME=leadflow
DB_PASSWORD=

# The host Nginx address range, so X-Forwarded-For can be trusted from it and
# nowhere else. The docker bridge default covers the usual setup.
TRUSTED_PROXIES=172.16.0.0/12

# Throttling. Never raise these in production.
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=20

# Platform owner. Seeding refuses to run without a password outside local. The owner signs in at
# https://mohtam.pro/platform/login — never through a company's login.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_PASSWORD=

# The platform console's own sign-in (/platform/login). With this on, a platform account must enrol
# an authenticator app before the console opens.
PLATFORM_REQUIRE_MFA=true
PLATFORM_SESSION_HOURS=12
PLATFORM_IMPERSONATION_MINUTES=30

# Subscriptions. 'manual': the platform owner activates and extends plans and records invoices in the
# console. Prices live in the plans catalogue (console → Plans), not here.
BILLING_PROVIDER=manual
BILLING_PAST_DUE_GRACE_DAYS=14
# The plan a new company's trial runs on (a key from the catalogue).
TENANCY_DEFAULT_PLAN=enterprise

# Account emails (invitations, password links, digests) go out under this name.
MAIL_FROM_NAME=مهتم

# Backups. Point this at mounted off-server storage before going live.
BACKUP_RETAIN_DAYS=14

# Optional: shown to anyone hitting the app during a deploy's migration window.
MAINTENANCE_SECRET=

# Lets the deploy assert over HTTP that the build it just shipped is the one
# answering. Any long random string: openssl rand -hex 32
DEPLOY_SECRET=

# --- Ad platform credentials. Blank keeps a provider in sandbox mode. --------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# --- Google Sheets: the file picker (same Cloud project as the OAuth client) -----
# The API key is sent to the browser; restrict it to your origin and to the
# Picker API in the console. The project NUMBER, not its id.
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# --- Alerts and off-server backups --------------------------------------------
# Left commented on purpose: an empty value here would override the default
# rather than fall back to it.
#
# Send errors to a chat channel as well as the container log:
#   LOG_STACK=stderr,slack
#   LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#   LOG_ALERT_LEVEL=error
#
# Copy every nightly dump off this machine. Receives the file path as $1:
#   BACKUP_UPLOAD_COMMAND='rclone copyto "$1" remote:leadflow-backups/'
