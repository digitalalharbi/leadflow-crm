# ---------------------------------------------------------------------------
# Staging environment. Copy to .env.staging ON THE VPS and fill in.
# This file is a template only — .env.staging is git-ignored and must stay so.
#
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
# ---------------------------------------------------------------------------

# Generate with: docker compose -f docker-compose.staging.yml run --rm backend \
#   php artisan key:generate --show
APP_KEY=

# How the app is reached. With a domain and TLS, leave APP_SCHEME unset.
#
# With an IP and no certificate yet, set all three to the IP and the scheme to
# http, and use docker/nginx/edge-ip.conf.example — one origin, /api routed to
# the API container. Tokens then cross the network in clear text, so treat that
# as a demo configuration and point a domain here before real data exists.
#
#   APP_SCHEME=http
#   STAGING_DOMAIN=203.0.113.10
#   STAGING_API_DOMAIN=203.0.113.10
APP_SCHEME=

# Domains. Both must resolve to this VPS and have certificates.
STAGING_DOMAIN=staging.example.com
STAGING_API_DOMAIN=staging-api.example.com

# Database. A password only this environment uses.
DB_DATABASE=leadflow_staging
DB_USERNAME=leadflow
DB_PASSWORD=

# The host Nginx address range, so X-Forwarded-For can be trusted from it and
# nowhere else. The docker bridge default covers the usual setup.
TRUSTED_PROXIES=172.16.0.0/12

# Throttling. Staging mirrors production unless you are pointing a load test at it.
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=20

# Platform owner. Seeding refuses to run without a password outside local.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_PASSWORD=

# Backups. Point this at mounted off-server storage before going live.
BACKUP_RETAIN_DAYS=14

# Optional: shown to anyone hitting the app during a deploy's migration window.
MAINTENANCE_SECRET=

# Lets the deploy assert over HTTP that the build it just shipped is the one
# answering. Any long random string: openssl rand -hex 32
DEPLOY_SECRET=

# --- Ad platform credentials. Blank keeps a provider in sandbox mode. --------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
