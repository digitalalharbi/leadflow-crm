APP_NAME="مهتم"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Root domain used to resolve tenants from subdomains (client1.example.com)
APP_CENTRAL_DOMAIN=localhost
# SPA origin(s) allowed to call the API, comma separated (used for CORS).
FRONTEND_URL=http://localhost:5173
# Sanctum's cookie mode is intentionally not enabled — the SPA uses Bearer
# tokens from another origin, and cookie mode would answer 419 to every write.
SESSION_DOMAIN=null

# Comma-separated proxy addresses or CIDRs to trust for X-Forwarded-* headers.
# Leave EMPTY unless the app sits behind a load balancer you control: trusting
# every proxy lets a caller forge their IP, which bypasses the login rate limit
# and falsifies the audit log.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leadflow_local
DB_USERNAME=leadflow
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log

# The live feed. `log` above keeps it off: nothing is published, the websocket
# container sits idle, and every screen refetches on its timer exactly as it did
# before. Switch to `reverb` and fill these in to turn it on — the three values
# are shared secrets between the app and its own websocket server, so generate
# them per environment and never reuse staging's in production.
#
#   BROADCAST_CONNECTION=reverb
#   REVERB_APP_ID=
#   REVERB_APP_KEY=
#   REVERB_APP_SECRET=
#   REVERB_HOST=ws.example.com
#   REVERB_PORT=443
#   REVERB_SCHEME=https
#
# The live feed is published from the queue, so Horizon (or any worker) must be
# running or nothing arrives however healthy the websocket server looks. That is
# the first thing to check when the feed is silent.
#
# The browser needs the key and host too, at build time, as VITE_REVERB_APP_KEY,
# VITE_REVERB_HOST, VITE_REVERB_PORT and VITE_REVERB_SCHEME. The key is public
# by design; the secret is not and never goes near the frontend build.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

HORIZON_PREFIX=leadflow_horizon:

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform super admin. Seeding REFUSES to run outside local development unless
# SUPER_ADMIN_PASSWORD is set — this account can read and rebrand every tenant.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_PASSWORD=

# Requests per minute per authenticated user (per IP when anonymous).
API_RATE_LIMIT_PER_MINUTE=120

# Login throttling. Keep these low in production; an automated browser suite
# needs them raised, which is why they are configurable rather than hard-coded.
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=20

# Webhook ingestion guardrails
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# --- External integrations (see EXTERNAL_SETUP.md). Empty => provider runs in sandbox/mock mode.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
