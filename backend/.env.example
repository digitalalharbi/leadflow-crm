APP_NAME="LeadFlow CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Root domain used to resolve tenants from subdomains (client1.example.com)
APP_CENTRAL_DOMAIN=localhost
# SPA origin(s) allowed to call the API, comma separated
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=null

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leadflow_local
DB_USERNAME=leadflow
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

HORIZON_PREFIX=leadflow_horizon:

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform super admin bootstrapped by `php artisan leadflow:create-super-admin`
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME="Platform Owner"

# Webhook ingestion guardrails
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# --- External integrations (see EXTERNAL_SETUP.md). Empty => provider runs in sandbox/mock mode.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
