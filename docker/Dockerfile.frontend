# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Builds the SPA to static files. The runtime stage is just Nginx serving them,
# so there is no Node process in production.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# The API base URL is baked in at build time; staging and production pass
# different values, which is why each environment builds its own image.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS production

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
