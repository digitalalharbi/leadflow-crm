# ---------------------------------------------------------------------------
# Host Nginx for a server that has an IP but no domain yet.
#
# The domain setup in edge.conf.example serves the app and the API on two
# hostnames. A bare IP has only one, so this routes by path instead: /api to
# the API container, everything else to the SPA. Same containers, same ports —
# only the front door differs.
#
# There is no TLS here, because a public certificate authority will not issue
# for an IP address. That is the whole reason this is staging-only:
#
#   - session cookies and bearer tokens cross the network in clear text;
#   - anyone on the path can read or alter a request.
#
# Use it to get a deployment working and to demo. Point a domain at the server
# before any real customer data exists, then switch to edge.conf.example.
#
#   cp docker/nginx/edge-ip.conf.example /etc/nginx/sites-available/leadflow
#   ln -s /etc/nginx/sites-available/leadflow /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# ---------------------------------------------------------------------------

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Uploads and CSV imports; matches the API container's own limit.
    client_max_body_size 12m;

    # The API container is mounted under /api so one origin serves both. The
    # trailing slashes matter: without them /api/v1/x would arrive as /v1/x.
    location /api/ {
        proxy_pass http://127.0.0.1:8081/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Kept free for the day a domain arrives and certbot needs it.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
}
